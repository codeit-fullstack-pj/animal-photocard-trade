PORT=4000

CORS_ENABLED=false
CORS_ORIGIN=http://localhost:3000
# 소셜 로그인이 끝난 뒤 돌려보낼 웹 주소
WEB_URL=http://localhost:3000

# 앱이 쓰는 연결 (Supabase면 Transaction pooler, 포트 6543)
DATABASE_URL="postgresql://postgres.your-project-ref:{password}@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true"
# prisma migrate가 쓰는 직접 연결 (Supabase Connect > Session pooler 또는 Direct connection, 포트 5432)
DIRECT_URL="postgresql://postgres.your-project-ref:{password}@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=public"

# Authentication > URL Configuration > Redirect URLs 에 http://localhost:4000/api/v1/auth/social/callback 추가
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key
