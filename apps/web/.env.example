# API 서버 주소 (apps/api, 기본 포트 4000, 라우트 prefix /api/v1)
# apps/api/.env에서 CORS_ENABLED=true로 보호를 켰다면 CORS_ORIGIN이 이 웹의 주소(http://localhost:3000)여야 한다
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# 다른 사용자로 인한 포인트·알림 변경을 실시간으로 받기 위한 Supabase Realtime 연결 정보.
# apps/api/.env의 SUPABASE_URL/SUPABASE_ANON_KEY와 동일한 값 — 둘 다 공개해도 되는 값이라 NEXT_PUBLIC 접두사를 씀
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key
